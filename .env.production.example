# =========================================================================
# LexAI Production Environment Configuration Template (.env.production.example)
# Copy to .env or inject via secret manager in your production orchestrator.
# NEVER commit the actual .env file or production secrets to source control.
# =========================================================================

# -------------------------------------------------------------------------
# Application Environment
# -------------------------------------------------------------------------
ENVIRONMENT=production
PROJECT_NAME="LexAI Production API"
VERSION="1.0.0"

# -------------------------------------------------------------------------
# Security Guardrails & Cryptographic Keys
# IMPORTANT: In production, SECRET_KEY must be a cryptographically secure
# random string with a minimum length of 32 characters.
# Generate with: openssl rand -hex 32
# -------------------------------------------------------------------------
SECRET_KEY="REPLACE_WITH_OPENSSL_RAND_HEX_32_GENERATED_SECRET"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -------------------------------------------------------------------------
# Initial Production Administrator (Optional)
# If left blank, a secure random 24-character password will be auto-generated
# and displayed in the terminal during: python -m scripts.seed_production
# -------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL="admin@lexai.internal"
INITIAL_ADMIN_PASSWORD="REPLACE_WITH_STRONG_ADMIN_PASSWORD_OR_LEAVE_BLANK_TO_AUTOGENERATE"
INITIAL_ADMIN_NAME="LexAI System Administrator"

# -------------------------------------------------------------------------
# Trusted Reverse Proxy & Ingress
# Restricts Uvicorn forwarded-header trust strictly to trusted reverse proxy IPs.
# -------------------------------------------------------------------------
FORWARDED_ALLOW_IPS="127.0.0.1,172.16.0.0/12,10.0.0.0/8"

# -------------------------------------------------------------------------
# Authentication Rate Limiting
# Maximum login attempts allowed per client IP within 60 seconds.
# Excess attempts return HTTP 429 Too Many Requests.
# -------------------------------------------------------------------------
AUTH_RATE_LIMIT_LOGIN=10

# -------------------------------------------------------------------------
# Database Architecture (PgBouncer + Direct Migration Routing)
# IMPORTANT: Use hexadecimal format (openssl rand -hex 24) for passwords to avoid
# URL special-character parsing errors (@, :, /, ?) in database connection strings.
# If your password contains special characters, URL-encode them with urllib.parse.quote_plus().
# -------------------------------------------------------------------------
POSTGRES_DB=lexai
POSTGRES_USER=lexai_user
POSTGRES_PASSWORD="REPLACE_WITH_HEX_GENERATED_PASSWORD_OPENSSL_RAND_HEX_24"

# Application Database URL: Points to PgBouncer on port 6432 (transaction pooling)
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@pgbouncer:6432/${POSTGRES_DB}

# Migration Database URL: Points DIRECTLY to PostgreSQL on port 5432 (bypasses PgBouncer for DDL)
MIGRATION_DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# -------------------------------------------------------------------------
# Connection Pool Budgeting (Per Application Worker)
# Formula: Total Connections = Workers * (DB_POOL_SIZE + DB_MAX_OVERFLOW) <= PgBouncer MAX_CLIENT_CONN
# PgBouncer default_pool_size (server connections to PostgreSQL) <= PostgreSQL max_connections
# -------------------------------------------------------------------------
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# -------------------------------------------------------------------------
# Distributed Cache & Rate Limiting (Redis with Password Authentication)
# -------------------------------------------------------------------------
REDIS_PASSWORD="REPLACE_WITH_STRONG_GENERATED_REDIS_PASSWORD_OPENSSL_RAND_HEX_24"
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# -------------------------------------------------------------------------
# CORS Whitelist (Strictly validated in production: JSON array, no wildcards)
# -------------------------------------------------------------------------
CORS_ORIGINS='["https://lex-ai-rust-five.vercel.app"]'

# -------------------------------------------------------------------------
# AI & Document Analysis (OpenAI API)
# -------------------------------------------------------------------------
OPENAI_API_KEY="sk-proj-REPLACE_WITH_PRODUCTION_OPENAI_API_KEY"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# -------------------------------------------------------------------------
# Storage Configuration
# Mount persistent Docker volume to /app/uploads or use cloud object storage.
# -------------------------------------------------------------------------
UPLOAD_DIR="/app/uploads"
MAX_UPLOAD_SIZE=20971520
