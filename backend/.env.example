# LexAI Backend Configuration

# Database Configuration
# For PostgreSQL (default production setting):
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lexai

# For SQLite (local development / testing fallback):
# DATABASE_URL=sqlite:///./lexai.db

# JWT Security
SECRET_KEY=lexai-super-secret-jwt-key-2026-production-ready
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI & LLM Settings
# If OPENAI_API_KEY is unset or empty, the deterministic legal RAG engine with fallback is automatically used
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Document Storage & Uploads
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE=20971520

# Project Settings
PROJECT_NAME="LexAI API"
VERSION="1.0.0"
