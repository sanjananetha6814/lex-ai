


# =========================================================================
# LexAI Load-Testing Suite Environment Configuration Example
# =========================================================================

# Target Base URL for LexAI backend
LEXAI_BASE_URL=http://127.0.0.1:8000

# Test Credentials (uses default seeded demonstration user)
LEXAI_TEST_EMAIL=alex.morgan@workspace.lexai
LEXAI_TEST_PASSWORD=DemoUserPass123!

# Safety Gates (Keep false to run safe read-only tests)
# Set to 'true' only when deliberately profiling these specific subsystems:
LEXAI_ENABLE_AI_TESTS=false
LEXAI_ENABLE_WRITE_TESTS=false
LEXAI_ENABLE_DOCUMENT_TESTS=false
